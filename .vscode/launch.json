{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ColombiaInvest: abrir el tablero",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "ColombiaInvest: reconstruir los datos",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--reconstruir", "--solo-datos"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": { "PYTHONIOENCODING": "utf-8" }
    },
    {
      "name": "ColombiaInvest: pruebas",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": { "PYTHONIOENCODING": "utf-8" }
    }
  ]
}
